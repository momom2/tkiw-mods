# Build output. Not anchored: the workspace root has one, and a crate built
# on its own before it joined the workspace leaves another behind.
target/
**/dist/

# Local runtime state: carries absolute paths, usernames, and the contents of a
# real save. Never commit, never ship.
**/*.log
**/*.log.*
**/momomod.ini
**/momomod.reference.ini
**/config.ini
**/config.reference.ini
# The per-mod config files, which are the same thing one file per mod. Every one
# is regenerated by the kit on first launch, except the picker's, which is the
# player's own tuning and theirs to keep.
**/config/*.ini
**/probe.incomplete
**/save-backups/

# Regenerable analysis caches: seconds to rebuild, megabytes to store.
knowledge-base/tools/*.pickle
**/__pycache__/

# A save copy taken before an unattended session. Delete once you are happy.
/_restore-point-before-claude-session/

# The game's own files and anything extracted from them. Never publish these:
# the executable is the shipped product, and the library dump is its content.
**/*.exe
**/*.exe.orig
**/libraries.json
**/*.pickle

# A player's own settings, and the migrated copy of an older config.
**/*.ini.migrated

# Extracted game content in any shape. The picker's docs describe the option
# lists it picks from; they are the game's data, not this project's.
tkiw-reward-auto-picker/docs/*.json

# Per-machine tool settings, not project configuration.
.claude/settings.local.json

# One CSV per profiling launch. Regenerable, and specific to one machine.
**/profiles/
**/*.ini.premeasure
**/profile.csv
